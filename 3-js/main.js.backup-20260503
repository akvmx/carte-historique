        class WindowManager {
            constructor() {
                this.windows = new Map(); // id -> { element, state }
                this.windowCounter = 0;
                this.offsetX = 0;
                this.offsetY = 0;
                this.activeWindow = null;
                
                // Créer le conteneur de fenêtres
                this.container = document.createElement('div');
                this.container.id = 'floating-windows-container';
                document.body.appendChild(this.container);
            }

            createWindow(options = {}) {
                const {
                    title = 'Fenêtre',
                    content = '',
                    width = 450,
                    height = 400,
                    x = null,
                    y = null,
                    onClose = null
                } = options;

                const id = `floating-window-${++this.windowCounter}`;
                
                // Calculer la position (cascade si non spécifiée)
                const posX = x ?? 100 + (this.windows.size * 30);
                const posY = y ?? 100 + (this.windows.size * 30);

                // Créer l'élément
                const windowEl = document.createElement('div');
                windowEl.className = 'floating-window active';
                windowEl.id = id;
                windowEl.style.cssText = `
                    left: ${posX}px;
                    top: ${posY}px;
                    width: ${width}px;
                    height: ${height}px;
                `;

                windowEl.innerHTML = `
                    <div class="floating-window-header">
                        <span class="floating-window-title">${title}</span>
                        <div class="floating-window-controls">
                            <button class="floating-window-btn minimize" title="Réduire">−</button>
                            <button class="floating-window-btn maximize" title="Agrandir">□</button>
                            <button class="floating-window-btn close" title="Fermer">×</button>
                        </div>
                    </div>
                    <div class="floating-window-body">
                        ${content}
                    </div>
                `;

                this.container.appendChild(windowEl);

                // Stocker la fenêtre
                this.windows.set(id, {
                    element: windowEl,
                    state: 'normal', // normal | minimized | maximized
                    prevState: null,
                    onClose
                });

                // Setup interactions
                this.setupWindowInteractions(id);
                this.bringToFront(id);

                return id;
            }

            setupWindowInteractions(id) {
                const win = this.windows.get(id);
                if (!win) return;

                const el = win.element;
                const header = el.querySelector('.floating-window-header');
                const minimizeBtn = el.querySelector('.floating-window-btn.minimize');
                const maximizeBtn = el.querySelector('.floating-window-btn.maximize');
                const closeBtn = el.querySelector('.floating-window-btn.close');

                // Clic pour mettre au premier plan
                el.addEventListener('mousedown', () => this.bringToFront(id));

                // Drag
                let isDragging = false;
                let startX, startY, initialLeft, initialTop;

                header.addEventListener('mousedown', (e) => {
                    if (e.target.closest('.floating-window-btn')) return;
                    if (win.state === 'maximized') return;

                    isDragging = true;
                    startX = e.clientX;
                    startY = e.clientY;
                    initialLeft = el.offsetLeft;
                    initialTop = el.offsetTop;
                    
                    el.style.transition = 'none';
                    this.bringToFront(id);
                });

                document.addEventListener('mousemove', (e) => {
                    if (!isDragging) return;
                    
                    const dx = e.clientX - startX;
                    const dy = e.clientY - startY;
                    
                    el.style.left = `${initialLeft + dx}px`;
                    el.style.top = `${initialTop + dy}px`;
                });

                document.addEventListener('mouseup', () => {
                    if (isDragging) {
                        isDragging = false;
                        el.style.transition = '';
                    }
                });

                // Boutons
                minimizeBtn.addEventListener('click', () => this.toggleMinimize(id));
                maximizeBtn.addEventListener('click', () => this.toggleMaximize(id));
                closeBtn.addEventListener('click', () => this.closeWindow(id));
            }

            bringToFront(id) {
                // Retirer la classe active de toutes les fenêtres
                this.windows.forEach((win) => {
                    win.element.classList.remove('active');
                });
                
                // Activer celle-ci
                const win = this.windows.get(id);
                if (win) {
                    win.element.classList.add('active');
                    this.activeWindow = id;
                }
            }

            toggleMinimize(id) {
                const win = this.windows.get(id);
                if (!win) return;

                if (win.state === 'minimized') {
                    win.element.classList.remove('minimized');
                    win.state = 'normal';
                } else {
                    win.element.classList.remove('maximized');
                    win.element.classList.add('minimized');
                    win.state = 'minimized';
                }
            }

            toggleMaximize(id) {
                const win = this.windows.get(id);
                if (!win) return;

                if (win.state === 'maximized') {
                    win.element.classList.remove('maximized');
                    win.state = 'normal';
                } else {
                    win.element.classList.remove('minimized');
                    win.element.classList.add('maximized');
                    win.state = 'maximized';
                }
            }

            closeWindow(id) {
                const win = this.windows.get(id);
                if (!win) return;

                if (win.onClose) win.onClose();
                
                win.element.remove();
                this.windows.delete(id);
            }

            closeAll() {
                this.windows.forEach((_, id) => this.closeWindow(id));
            }

            // Mettre à jour le contenu d'une fenêtre
            setContent(id, html) {
                const win = this.windows.get(id);
                if (!win) return;
                
                const body = win.element.querySelector('.floating-window-body');
                if (body) body.innerHTML = html;
            }

            // Mettre à jour le titre d'une fenêtre
            setTitle(id, title) {
                const win = this.windows.get(id);
                if (!win) return;
                
                const titleEl = win.element.querySelector('.floating-window-title');
                if (titleEl) titleEl.textContent = title;
            }
        }

        class HistoricalMapWithSync {
