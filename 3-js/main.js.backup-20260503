            getFilteredTimelineEventsMulti() {
                const events = Array.isArray(this.cache.events) ? this.cache.events : [];

                const countries = this.timelineSelectedCountries || [];
                const persons   = this.timelineSelectedPersons || [];
                const mode      = this.timelineFilterMode || 'union';

                // Aucun filtre => tout
                if (!countries.length && !persons.length) return events.slice();

                // Pré-calcul persons -> Set d'évènements via personIndex si dispo (sinon fallback sur scan)
                let personEventSet = null;
                if (persons.length && this.personIndex) {
                    personEventSet = new Set();
                    persons.forEach(p => {
                        const node = this.personIndex[p];
                        const pevs = node && Array.isArray(node.events) ? node.events : [];
                        pevs.forEach(ev => personEventSet.add(ev));
                    });
                }

                const matchesCountry = (ev) => {
                    if (!countries.length) return false;
                    return countries.some(c => this.eventBelongsToCountry(ev, c));
                };

                const matchesPerson = (ev) => {
                    if (!persons.length) return false;

                    // si on a un Set direct des events de personnes (via personIndex), c'est rapide
                    if (personEventSet) return personEventSet.has(ev);

                    // fallback : essaie de matcher via champ "personnages" si présent
                    const list = ev && ev.personnages;
                    if (Array.isArray(list)) {
                        const lower = list.map(x => (x || '').toString().toLowerCase());
                        return persons.some(p => lower.includes((p || '').toLowerCase()));
                    }
                    if (typeof list === 'string') {
                        const lower = list.split(',').map(s => s.trim().toLowerCase());
                        return persons.some(p => lower.includes((p || '').toLowerCase()));
                    }
                    return false;
                };

                return events.filter(ev => {
                    // Si un côté est vide, on applique seulement l'autre (quel que soit le mode)
                    if (countries.length && !persons.length) return matchesCountry(ev);
                    if (!countries.length && persons.length) return matchesPerson(ev);

                    // Les deux côtés sont actifs
                    if (mode === 'intersection') {
                        return matchesCountry(ev) && matchesPerson(ev);
                    }
                    // union
                    return matchesCountry(ev) || matchesPerson(ev);
                });
            }

            showMultiFilteredTimeline() {
