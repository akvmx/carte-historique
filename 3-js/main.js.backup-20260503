            // Nouvelle méthode : navigation clavier dans les résultats
            setupSearchKeyboardNavigation() {
                const input = document.getElementById('global-search-input');
                const container = document.getElementById('global-search-results');
                
                if (!input) return;

                input.addEventListener('keydown', (e) => {
                    if (!container?.classList.contains('open')) return;
                    
                    const items = container.querySelectorAll('.global-search-item');
                    if (!items.length) return;

                    if (e.key === 'ArrowDown') {
                        e.preventDefault();
                        this.searchSelectedIndex = Math.min(
                            this.searchSelectedIndex + 1, 
                            items.length - 1
                        );
                        this.updateSearchSelection(items);
                    } 
                    else if (e.key === 'ArrowUp') {
                        e.preventDefault();
                        this.searchSelectedIndex = Math.max(this.searchSelectedIndex - 1, 0);
                        this.updateSearchSelection(items);
                    } 
                    else if (e.key === 'Enter' && this.searchSelectedIndex >= 0) {
                        e.preventDefault();
                        const selectedBtn = items[this.searchSelectedIndex];
                        if (selectedBtn) {
                            this.handleSearchItemClick(selectedBtn);
                        }
                    }
                });

                // Raccourci Ctrl/Cmd + K pour focus
                document.addEventListener('keydown', (e) => {
                    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
                        e.preventDefault();
                        input.focus();
                        input.select();
                    }
                });
            }

