            openInFloatingWindow(options = {}) {
                const { type, name, event, lien } = options;

                let title = '';
                let content = '<p>Chargement...</p>';

                if (type === 'country') {
                    title = `🌍 ${name}`;
                    const windowId = this.windowManager.createWindow({ title, content, width: 500, height: 450 });

                    const countryHtml = this.buildCountryWindowContent(name);
                    this.windowManager.setContent(windowId, countryHtml);

                    this.attachFloatingWindowInteractions(windowId);

                } else if (type === 'person') {
                    title = `👤 ${name}`;
                    const windowId = this.windowManager.createWindow({ title, content, width: 500, height: 450 });

                    const personHtml = this.buildPersonWindowContent(name);
                    this.windowManager.setContent(windowId, personHtml);

                    this.attachFloatingWindowInteractions(windowId);

                } else if (type === 'event') {
                    const eventTitle = event?.titre || 'Événement';
                    title = `📜 ${eventTitle}`;

                    const windowId = this.windowManager.createWindow({ 
                        title, 
                        content: `
                            <div class="loading">
                                <span class="loading-text">Chargement de l'événement...</span>
                            </div>
                        `, 
                        width: 550, 
                        height: 500 
                    });

                    if (lien && lien !== '#') {
                        this.loadEventHtml(lien).then(eventHtml => {
                            this.windowManager.setContent(windowId, eventHtml);
                            this.attachFloatingWindowInteractions(windowId);
                        });
                    } else {
                        this.windowManager.setContent(windowId, `
                            <article class="event-content">
                                <h1>${eventTitle}</h1>
                                <p class="floating-empty-text">
                                    Aucun contenu détaillé disponible pour cet événement.
                                </p>
                                ${event?.description ? `<p>${event.description}</p>` : ''}
                                ${event?.date ? `
                                    <div class="event-meta-box">
                                        <div class="event-meta-item">
                                            <span class="meta-icon">📅</span>
                                            <span class="meta-value">${event.date}</span>
                                        </div>
                                        ${event?.pays ? `
                                            <div class="event-meta-item">
                                                <span class="meta-icon">🌍</span>
                                                <span class="meta-value">${event.pays}</span>
                                            </div>
                                        ` : ''}
                                    </div>
                                ` : ''}
                            </article>
                        `);
                    }

                // ✅ NOUVEAU : Support des notes
                } else if (type === 'note') {
                    title = `📝 ${name}`;

                    const windowId = this.windowManager.createWindow({ 
                        title, 
                        content: `
                            <div class="loading">
                                <span class="loading-text">Chargement de la note...</span>
                            </div>
                        `, 
                        width: 550, 
                        height: 500 
                    });

                    if (lien && lien !== '#') {
                        // Charger le contenu HTML de la note (réutilise la même méthode que les events)
                        this.loadEventHtml(lien).then(noteHtml => {
                            this.windowManager.setContent(windowId, noteHtml);
                            this.attachFloatingWindowInteractions(windowId);
                        }).catch(err => {
                            console.error('Erreur chargement note:', err);
                            this.windowManager.setContent(windowId, `
                                <article class="note-content">
                                    <h1>${name}</h1>
                                    <p class="floating-empty-text">
                                        Impossible de charger cette note.
                                    </p>
                                </article>
                            `);
                        });
                    } else {
                        this.windowManager.setContent(windowId, `
                            <article class="note-content">
                                <h1>${name}</h1>
                                <p class="floating-empty-text">
                                    Aucun contenu disponible pour cette note.
                                </p>
                            </article>
                        `);
                    }
