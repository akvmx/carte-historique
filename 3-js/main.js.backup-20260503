            setupGlobalClickHandlers() {
                document.addEventListener('click', (e) => {
                    
                    // ❌ Ignorer les clics dans les fenêtres flottantes
                    if (e.target.closest('.floating-window')) {
                        return;
                    }

                    // 1. Clic sur un pays
                    const countryEl = e.target.closest('[data-country]');
                    if (countryEl) {
                        e.preventDefault();
                        e.stopPropagation();
                        const name = countryEl.getAttribute('data-country');
                        if (name) {
                            // ✅ Fermer l'annuaire s'il est ouvert
                            this.closeDirectory();
                            this.openInFloatingWindow({ type: 'country', name });
                        }
                        return;
                    }

                    // 2. Clic sur un personnage
                    const personEl = e.target.closest('[data-person]');
                    if (personEl) {
                        e.preventDefault();
                        e.stopPropagation();
                        const name = personEl.getAttribute('data-person');
                        if (name) {
                            // ✅ Fermer l'annuaire s'il est ouvert
                            this.closeDirectory();
                            this.openInFloatingWindow({ type: 'person', name });
                        }
                        return;
                    }

                    // 3. Clic sur une note
                    const noteEl = e.target.closest('[data-note]');
                    if (noteEl) {
                        e.preventDefault();
                        e.stopPropagation();
                        const titre = noteEl.getAttribute('data-note');
                        const lien = noteEl.getAttribute('data-lien');
                        if (lien && lien !== '#') {
                            this.openInFloatingWindow({ 
                                type: 'note', 
                                name: titre,
                                lien 
                            });
                        }
                        return;
                    }
                    
                    // 4. Clic sur un événement avec lien
                    const eventEl = e.target.closest('[data-lien]');
                    if (eventEl) {
                        const lien = eventEl.getAttribute('data-lien');
                        if (lien && lien !== '#') {
                            e.preventDefault();
                            e.stopPropagation();
                            const titre = eventEl.querySelector('.event-title, .timeline-event-title, .floating-event-title')?.textContent || 'Événement';
                            this.openInFloatingWindow({ 
                                type: 'event', 
                                event: { titre }, 
                                lien 
                            });
                        }
                        return;
                    }
                });
            }

            buildCountryWindowContent(countryName) {
                // 1) Trouver le pays dans le cache
                const country = (this.cache.countries || []).find(
                    c => c.pays.toLowerCase() === countryName.toLowerCase()
                );

                // 2) Récupérer les événements du pays
                const events = (this.cache.events || [])
                    .filter(ev => this.eventBelongsToCountry(ev, countryName))
                    .sort((a, b) => new Date(a.date) - new Date(b.date));

                // 3) Extraire les personnages liés à ce pays
                const personsSet = new Set();
                events.forEach(ev => {
                    let persons = ev.personnages || ev.personnages_list || ev.persons;
                    if (!persons) return;
                    if (typeof persons === 'string') {
                        persons = persons.split(',').map(p => p.trim()).filter(Boolean);
                    }
                    if (Array.isArray(persons)) {
                        persons.forEach(p => personsSet.add(p));
                    }
                });
                const relatedPersons = Array.from(personsSet);

                // 4) Construire le HTML des personnages
                const personsHtml = relatedPersons.length > 0 
                    ? relatedPersons.map(p => 
                        `<button class="floating-chip" data-person="${p}">👤 ${p}</button>`
                    ).join('')
                    : '';

                // 5) Construire le HTML des événements (avec classes cliquables)
                const eventsHtml = events.length === 0
                    ? `<p class="floating-empty-text">Aucun événement référencé pour ce pays.</p>`
                    : events.slice(0, 20).map(ev => {
                        const icon = this.getCategoryIcon ? this.getCategoryIcon(ev.categorie) : '📌';
                        const dateStr = ev.date ? this.formatDateHuman(ev.date) : '';
                        const lien = ev.lien && ev.lien !== '#' ? ev.lien : null;
                        
                        return `
                            <li class="floating-event-item ${lien ? 'clickable' : ''}" 
                                ${lien ? `data-lien="${lien}"` : ''}>
                                <span class="floating-event-icon">${icon}</span>
                                <div class="floating-event-content">
                                    <span class="floating-event-title">${ev.titre || '(sans titre)'}</span>
                                    ${dateStr ? `<span class="floating-event-date">${dateStr}</span>` : ''}
                                </div>
                            </li>
                        `;
                    }).join('');

                // 6) Informations supplémentaires du pays
                const continent = country?.continent || '';
                const coordonnees = country?.coordonnees || null;

                // 7) Assemblage final
                return `
                    <div class="floating-content">
                        <header class="floating-header">
                            <div class="floating-portrait">
                                <div class="floating-portrait-placeholder">🌍</div>
                            </div>
                            <div class="floating-header-info">
                                <h2 class="floating-name">${countryName}</h2>
                                ${continent ? `<p class="floating-subtitle">${continent}</p>` : ''}
                                <p class="floating-meta">
                                    <strong>${events.length}</strong> événement${events.length > 1 ? 's' : ''} · 
                                    <strong>${relatedPersons.length}</strong> personnage${relatedPersons.length > 1 ? 's' : ''}
                                </p>
                            </div>
                        </header>

                        ${personsHtml ? `
                            <section class="floating-section">
                                <h4 class="floating-section-title">👤 Personnages liés</h4>
                                <div class="floating-chips">${personsHtml}</div>
                            </section>
                        ` : ''}

                        <section class="floating-section">
                            <h4 class="floating-section-title">📅 Chronologie${events.length > 20 ? ` (20 premiers sur ${events.length})` : ''}</h4>
                            ${events.length > 0 
                                ? `<ul class="floating-events-list">${eventsHtml}</ul>`
                                : `<p class="floating-empty-text">Aucun événement référencé.</p>`
                            }
                        </section>
                    </div>
                `;
            }

            buildPersonWindowContent(personName) {
                // 1) Construire l'index des personnages
                const index = {};
                
                (this.cache.persons || []).forEach(meta => {
                    if (!meta || !meta.nom) return;
                    index[meta.nom.toLowerCase()] = {
                        nom: meta.nom,
                        titre: meta.titre || meta.nom,
                        naissance: meta.naissance || null,
                        mort: meta.mort || null,
                        lieuNaissance: meta.lieu_naissance || null,
                        lieuMort: meta.lieu_mort || null,
                        fonction: meta.fonction || null,
                        paysPrincipaux: Array.isArray(meta.pays_principaux) ? meta.pays_principaux : [],
                        image: meta.image || null,
                        bioCourte: meta.bio_courte || null,
                        bioLongue: meta.bio_longue || null,
                        events: []
                    };
                });

                (this.cache.events || []).forEach(ev => {
                    let persons = ev.personnages || ev.personnages_list || ev.persons;
                    if (!persons) return;
                    if (typeof persons === 'string') {
                        persons = persons.split(',').map(p => p.trim()).filter(Boolean);
                    }
                    persons.forEach(name => {
                        const key = name.toLowerCase();
                        if (!index[key]) {
                            index[key] = { nom: name, titre: name, events: [] };
                        }
                        index[key].events.push(ev);
                    });
                });

                // 2) Récupérer le personnage
                const key = personName.toLowerCase();
                const person = index[key];

                if (!person) {
                    return `
                        <div class="floating-empty">
                            <div class="floating-empty-icon">👤</div>
                            <p class="floating-empty-text">Aucune information trouvée pour <strong>${personName}</strong>.</p>
                        </div>
                    `;
                }

                // 3) Métadonnées
                const metaParts = [];
                if (person.naissance) metaParts.push(`★ ${person.naissance}`);
                if (person.mort) metaParts.push(`✝ ${person.mort}`);
                if (person.fonction) metaParts.push(person.fonction);
                const metaText = metaParts.join(' · ');

                // 5) Biographie
                const bio = person.bioLongue || person.bioCourte || '';
                const bioHtml = bio 
                    ? (typeof marked !== 'undefined' ? marked.parse(bio) : `<p>${bio}</p>`)
                    : '';

                // 6) Pays
                const paysHtml = person.paysPrincipaux.length > 0 
                    ? person.paysPrincipaux.map(p => 
                        `<button class="floating-chip" data-country="${p}">${p}</button>`
                    ).join('')
                    : '';

                // 7) Événements
                const eventsHtml = person.events.length > 0 
                    ? person.events.map(ev => {
                        const icon = this.getCategoryIcon ? this.getCategoryIcon(ev.categorie) : '📌';
                        const dateStr = ev.date ? this.formatDateHuman(ev.date) : '';
                        const lien = ev.lien && ev.lien !== '#' ? ev.lien : null;
                        
                        return `
                            <li class="floating-event-item ${lien ? 'clickable' : ''}" 
                                ${lien ? `data-lien="${lien}"` : ''}>
                                <span class="floating-event-icon">${icon}</span>
                                <div class="floating-event-content">
                                    <span class="floating-event-title">${ev.titre || '(sans titre)'}</span>
                                    ${dateStr ? `<span class="floating-event-date">${dateStr}</span>` : ''}
                                </div>
                            </li>
                        `;
                    }).join('')
                    : '';

                // 8) Assemblage
                return `
                    <div class="floating-content">
                        <header class="floating-header">
                            <div class="floating-header-info">
                                <h2 class="floating-name">${person.nom}</h2>
                                ${person.titre && person.titre !== person.nom 
                                    ? `<p class="floating-subtitle">${person.titre}</p>` 
                                    : ''}
                                ${metaText ? `<p class="floating-meta">${metaText}</p>` : ''}
                            </div>
                        </header>

                        ${bioHtml ? `
                            <section class="floating-section">
                                <h4 class="floating-section-title">📜 Biographie</h4>
                                <div class="floating-bio">${bioHtml}</div>
                            </section>
                        ` : ''}

                        ${paysHtml ? `
                            <section class="floating-section">
                                <h4 class="floating-section-title">🌍 Pays associés</h4>
                                <div class="floating-chips">${paysHtml}</div>
                            </section>
                        ` : ''}

                        ${eventsHtml ? `
                            <section class="floating-section">
                                <h4 class="floating-section-title">📅 Événements (${person.events.length})</h4>
                                <ul class="floating-events-list">${eventsHtml}</ul>
                            </section>
                        ` : `
                            <section class="floating-section">
                                <p class="floating-empty-text">Aucun événement associé à ce personnage.</p>
                            </section>
                        `}
                    </div>
                `;
            }
            
            attachFloatingWindowInteractions(windowId) {
                const win = this.windowManager.windows.get(windowId);
                if (!win) return;
                
                const container = win.element.querySelector('.floating-window-body');
                if (!container) return;

                // 1) Clic sur un événement dans la liste
                container.querySelectorAll('.floating-event-item.clickable').forEach(item => {
                    item.addEventListener('click', () => {
                        const lien = item.getAttribute('data-lien');
                        const titre = item.querySelector('.floating-event-title')?.textContent || 'Événement';
                        
                        if (lien && lien !== '#') {
                            this.openInFloatingWindow({ 
                                type: 'event', 
                                lien,
                                event: { titre }
                            });
                        }
                    });
                });

                // 2) Clic sur un chip de pays
                container.querySelectorAll('.floating-chip[data-country]').forEach(chip => {
                    chip.addEventListener('click', () => {
                        const country = chip.getAttribute('data-country');
                        if (country) {
                            this.openInFloatingWindow({ type: 'country', name: country });
                        }
                    });
                });

                // 3) Clic sur un chip de personnage
                container.querySelectorAll('.floating-chip[data-person]').forEach(chip => {
                    chip.addEventListener('click', () => {
                        const person = chip.getAttribute('data-person');
                        if (person) {
                            this.openInFloatingWindow({ type: 'person', name: person });
                        }
                    });
                });

                // 4) Clic sur les liens dans le contenu markdown (événements)
                container.querySelectorAll('a[href^="#"]').forEach(link => {
                    link.addEventListener('click', (e) => {
                        e.preventDefault();
                        const href = link.getAttribute('href');
                        
                        // Lien vers un personnage: #person:NomPersonnage
                        if (href.startsWith('#person:')) {
                            const name = href.replace('#person:', '');
                            this.openInFloatingWindow({ type: 'person', name });
                        }
                        // Lien vers un pays: #country:NomPays
                        else if (href.startsWith('#country:')) {
                            const name = href.replace('#country:', '');
                            this.openInFloatingWindow({ type: 'country', name });
                        }
                    });
                });
            }

