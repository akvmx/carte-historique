                html += `<div class="timeline-century-list">`;

                // --- Aperçu d'événement (rempli au clic sur un point de la frise) ---
                const previewId = options.previewId || 'timeline-event-preview';

                html += `
                    <div id="${previewId}" class="timeline-event-preview" style="display:none;">
