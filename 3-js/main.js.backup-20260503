                if (!events.length) {
                    timelineContent.innerHTML = `
                        <h3 class="timeline-section-title">${title}</h3>
                        <p>Aucun événement ne correspond à tes filtres (ou à la période).</p>
                    `;
                    this.drawTimeline([]);
                    this.currentTimelineEvents = [];
                    return;
                }

                this.drawTimeline(events);

                timelineContent.innerHTML = this.buildTimelineList(events, {
                    title,
                    showCountries: true,   // on mélange pays + persos => on affiche les pays
                    showMiniMap: false
                });

                this.currentTimelineEvents = events;
                this.setupTimelineListInteractions(timelineContent, events, 'country');
            }

