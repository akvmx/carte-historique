                this.markers = null;
                this.selectedYear = 2024;
                this.selectedContinent = "tous";
                this.eventDisplayMode = "all"; // "year" ou "all"
                this.isDarkTheme = localStorage.getItem('theme-sombre') === 'true';
                this.isLoading = false;
                this.watchMode = false;
                this.timelineScaleMode = "auto"; // "auto" ou "fixed"
                this.timelineFixedPxPerYear = 4; // utilisé seulement si mode "fixed"
                this.timelineDots = [];
                this.selectedTimelineIndex = null;
                this.mainView = 'map';        // 'map' ou 'timeline'
                this.mobileMode = 'map';      // 'map' | 'events' | 'timeline'
                this.currentTimelineEvents = [];
                this.selectedComparisonSide = null;
                this.selectedComparisonIndex = null;
                this.timelineGlobalDots = [];
                this.currentGlobalTimelineEvents = [];
                this.selectedGlobalTimelineIndex = null;
                this.personIndex = {};              // index personnages -> { nom, events: [...] }
                this.currentTimelineContext = null; // { type: 'country' | 'person', name: string }
                this.timelineSelectedCountries = [];
                this.timelineSelectedPersons = [];
                this.timelineFilterMode = 'union'; // 'union' | 'intersection'
                this.detailMap = null;              // mini-carte dans la fiche
                this.sidebarCountryMap = null;
                this.closeSidebarDetail = null;

                // Cache et données
                this.cache = {
                    countries: [],
                    events: [],
                    persons: [],
                    lastSync: null
                };
                
                // URLs des données (adaptez selon votre structure)
                this.dataUrls = {
                    events: 'data/evenements.json',
                    countries: 'data/pays.json',
                    persons: 'data/personnes.json',
                    notes: 'data/notes.json'
                };

                
                this.init();

                // Zoom de la timeline par pays
                this.timelineZoom = 1;        // 1 = 1000 ans visibles par défaut
                this.timelineMinZoom = 0.5;   // dé-zoom max (2000 ans visibles)
                this.timelineMaxZoom = 5;     // zoom max (200 ans visibles)

                // Zoom de la timeline mondiale
                this.timelineGlobalZoom = 1;        // 1 = ~1000 ans visibles
                this.timelineGlobalMinZoom = 0.5;   // dé-zoom max (plus d'années)
                this.timelineGlobalMaxZoom = 5;     // zoom max (moins d'années)

                this.timelineMiniMap = null;
                this.timelineMiniLayer = null;

                // Gestionnaire de fenêtres flottantes
                this.windowManager = new WindowManager();
            }
            
            async init() {
                const initialView = localStorage.getItem('mainView') || 'map';
                console.log("🚀 Initialisation avec synchronisation Obsidian");
                
                // Appliquer le thème
                if (this.isDarkTheme) {
                    document.body.classList.add('theme-sombre');
                }
                
                // Initialiser les composants
                this.initMap();
                this.initControls();
                this.initObsidianSync();

                // Gestionnaire global des clics pour fenêtres flottantes
                this.setupGlobalClickHandlers();

                this.searchSelectedIndex = -1;
                this.currentSearchResults = [];
                this.setupSearchKeyboardNavigation();

                // ✅ Clic sur une carte évènement dans la timeline => ouvre la fiche HTML dans le même onglet
                const timelineView = document.getElementById('timeline-view');
                if (timelineView) {
                card.addEventListener('click', () => {
                    const lien = card.getAttribute('data-lien');
                    const titre = card.querySelector('.event-title')?.textContent || 'Événement';
                    this.openInFloatingWindow({ 
                        type: 'event', 
                        event: { titre }, 
                        lien 
                    });
                });
                }
                
                // Charger les données
                await this.loadData();
                this.updateDisplay();
                if (initialView === 'timeline') {
                    // ✅ 1) Si on a un état sauvegardé (retour depuis fiche), on le restaure
                    const restored = this.restoreTimelineStateFromSession();

                    // ✅ 2) Sinon, comportement par défaut : timeline mondiale
                    if (!restored) {
                        const worldTab = document.querySelector('.timeline-tab[data-mode="world"]');
                        if (worldTab) worldTab.click();
                        else this.showGlobalTimeline();
                    }
                }

                console.log("✅ Carte avec sync Obsidian initialisée");
            }
            
            initMap() {
                this.map = L.map('carte', {
                    center: [25, 10],        // centre un peu plus haut et décalé (Europe / Afrique / Moyen-Orient)
                    zoom: 3,                 // au lieu de 2 -> plus zoomé dès l'arrivée
                    minZoom: 3,              // tu ne peux plus dézoomer en dessous (plus de « monde minuscule »)
                    maxZoom: 18,
                    maxBounds: [[-85, -180], [85, 180]], // empêche de sortir du monde
                    maxBoundsViscosity: 1.0,             // effet « rebond » aux bords
                    worldCopyJump: true,
                    zoomControl: false
                });

                L.control.zoom({
                    position: 'bottomright'
                }).addTo(this.map);

                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 18
                }).addTo(this.map);

                this.markers = L.layerGroup().addTo(this.map);

                setTimeout(() => {
                    if (this.map) this.map.invalidateSize();
                }, 0);
            }
            
            initControls() {
                // Références pour la popup annuaire
                this.directoryOverlay = document.getElementById('directory-overlay');
                this.directoryTitleElem = document.getElementById('directory-title');
                this.directoryContentElem = document.getElementById('directory-content');
                
                // Contrôles de base
                document.getElementById('theme-btn').addEventListener('click', () => {
                    this.toggleTheme();
                });

                // Notes : recherche live
                const notesSearch = document.getElementById('notes-search');
                if (notesSearch) {
                    notesSearch.addEventListener('input', () => this.renderNotesList());
                }

                // 🔎 Barre de recherche globale (événements + personnages)
                const searchInput   = document.getElementById('global-search-input');
                const searchResults = document.getElementById('global-search-results');

                if (searchInput && searchResults) {
                    // Saisie : lancer la recherche à partir de 2 caractères
                    searchInput.addEventListener('input', (e) => {
                        const value = (e.target.value || '').trim();
                        if (value.length < 2) {
                            searchResults.innerHTML = '';
                            searchResults.classList.remove('open');
                            return;
                        }
                        this.updateGlobalSearchResults(value);
                    });

                    // Focus : si déjà des résultats pour la valeur courante, on les réaffiche
                    searchInput.addEventListener('focus', () => {
                        const value = (searchInput.value || '').trim();
                        if (value.length >= 2 && searchResults.innerHTML.trim() !== '') {
                            searchResults.classList.add('open');
                        }
                    });

                    // Échap pour nettoyer / fermer
                    searchInput.addEventListener('keydown', (e) => {
                        if (e.key === 'Escape') {
                            searchInput.value = '';
                            searchResults.innerHTML = '';
                            searchResults.classList.remove('open');
                            searchInput.blur();
                        }
                    });

                    // Fermeture si clic en dehors
                    document.addEventListener('click', (e) => {
                        const wrapper = document.getElementById('global-search');
                        if (!wrapper) return;
                        if (!wrapper.contains(e.target)) {
                            searchResults.innerHTML = '';
                            searchResults.classList.remove('open');
                        }
                    });
                }

                // Onglets desktop carte / chronologie
                const mainTabs = document.querySelectorAll('.main-tab');
                mainTabs.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const view = btn.dataset.mainView || 'map';
                        this.setMainView(view);

                        // Si on passe en vue "chronologie", on affiche automatiquement la timeline mondiale
                        if (view === 'timeline') {
                            const worldTab = document.querySelector('.timeline-tab[data-mode="world"]');
                            if (worldTab) {
                                // On simule un clic dessus pour tout mettre à jour proprement
                                worldTab.click();
                            } else {
                                // fallback au cas où
                                this.showGlobalTimeline();
                            }
                        }
                    });
                });

                // ========================================
                // ✅ NAVIGATION MOBILE (AJOUTE ÇA ICI)
                // ========================================
                const mobileNavBtns = document.querySelectorAll('.mobile-nav-btn');
                mobileNavBtns.forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        
                        const view = btn.dataset.view;
                        const action = btn.dataset.action;
                        
                        // Action menu : toggle sidebar
                        if (action === 'menu') {
                            const sidebar = document.getElementById('sidebar');
                            if (sidebar) {
                                sidebar.classList.toggle('collapsed');
                            }
                            return;
                        }
                        
                        // Changement de vue
                        if (view) {
                            this.setMobileView(view);
                            
                            // Mettre à jour l'état actif
                            mobileNavBtns.forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                        }
                    });
                });

                // Onglets mobile en bas
                const mobileTabs = document.querySelectorAll('.mobile-tab');
                mobileTabs.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const view = btn.dataset.mobileView || 'map';
                        this.setMobileMode(view);
                    });
                });


                // Boutons de filtre d'affichage
                document.querySelectorAll('.btn-filter').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        document.querySelectorAll('.btn-filter').forEach(b => 
                            b.classList.remove('active'));
                        e.target.classList.add('active');
                        
                        this.eventDisplayMode = e.target.dataset.filter;
                        this.updateDisplay();
                    });
                });

                // Bouton fiche (pays / personnage)
                const openDetailBtn = document.getElementById('open-detail-sheet');
                if (openDetailBtn) {
                    openDetailBtn.addEventListener('click', () => {
                        if (!this.currentTimelineContext) return;

                        if (this.currentTimelineContext.type === 'country') {
                            this.openInFloatingWindow({ type: 'country', name: this.currentTimelineContext.name });
                        } else if (this.currentTimelineContext.type === 'person') {
                            this.openInFloatingWindow({ type: 'person', name: this.currentTimelineContext.name });
                        }
                    });
                }

                // Fermeture de la fiche
                const detailOverlay = document.getElementById('detail-overlay');
                const detailClose   = document.getElementById('detail-close-btn'); // <-- bon id
                const detailBackBtn = document.getElementById('detail-back-btn');

                if (detailClose) {
                    detailClose.addEventListener('click', () => {
                        this.closeDetailOverlay();
                    });
                }

                if (detailBackBtn) {
                    detailBackBtn.addEventListener('click', () => {
                        this.closeDetailOverlay();
                    });
                }

                // clic sur le fond sombre = fermeture
                if (detailOverlay) {
                    detailOverlay.addEventListener('click', (e) => {
                        if (e.target === detailOverlay) {
                            this.closeDetailOverlay();
                        }
                    });
                }

                // Année : input + stepper (sans slider)
                const yearInput = document.getElementById('input-annee');
                const yearStepBtns = document.querySelectorAll('.btn-year-step');
                const yearResetBtn = document.querySelector('.btn-year-reset');

                let debounceTimer;

                // clamp simple
                const clampYear = (y) => {
                    if (!Number.isFinite(y)) return this.selectedYear;
                    if (y < -2000) return -2000;
                    if (y > 2024) return 2024;
                    return y;
                };

                // Fonction pour mettre à jour l'année
                const updateYear = (newYear) => {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(() => {
                        this.selectedYear = clampYear(newYear);
                        if (yearInput) yearInput.value = this.selectedYear;
                        this.updateDisplay();
                    }, 100);
                };

                // Input -> update (au fil de la saisie, mais seulement si c’est un nombre)
                if (yearInput) {
                    yearInput.addEventListener('input', (e) => {
                        const v = parseInt(e.target.value, 10);
                        if (Number.isFinite(v)) updateYear(v);
                    });

                    // Validation quand on appuie sur Entrée
                    yearInput.addEventListener('keypress', (e) => {
                        if (e.key === 'Enter') {
                            const v = parseInt(e.target.value, 10);
                            if (Number.isFinite(v)) {
                                updateYear(v);
                                yearInput.blur();
                            } else {
                                yearInput.value = this.selectedYear;
                            }
                        }
                    });

                    // Validation au blur (clic ailleurs)
                    yearInput.addEventListener('blur', () => {
                        const v = parseInt(yearInput.value, 10);
                        if (Number.isFinite(v)) updateYear(v);
                        else yearInput.value = this.selectedYear;
                    });
                }

                // Boutons -10/+10/-100/+100
                yearStepBtns.forEach(btn => {
                    btn.addEventListener('click', () => {
                        const step = parseInt(btn.getAttribute('data-step'), 10) || 0;
                        const current = parseInt(yearInput?.value, 10);
                        const base = Number.isFinite(current) ? current : this.selectedYear;
                        updateYear(base + step);
                    });
                });

                // Bouton reset (2024)
                if (yearResetBtn) {
                    yearResetBtn.addEventListener('click', () => {
                        const y = parseInt(yearResetBtn.getAttribute('data-year'), 10);
                        updateYear(Number.isFinite(y) ? y : 2024);
                    });
                }
                
                // Boutons continents
                document.querySelectorAll('.btn-continent').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        document.querySelectorAll('.btn-continent').forEach(b => 
                            b.classList.remove('active'));
                        e.target.classList.add('active');
                        
                        this.selectedContinent = e.target.dataset.continent;
                        this.updateDisplay();
                    });
                });

                // Toggle sidebar et timeline
                const sidebarEl = document.getElementById('sidebar');
                const timelineEl = document.getElementById('timeline');
                const toggleSidebarBtn = document.getElementById('toggle-sidebar');
                const toggleTimelineBtn = document.getElementById('toggle-timeline');

                // Masquer / afficher la sidebar
                if (toggleSidebarBtn && sidebarEl) {
                    toggleSidebarBtn.addEventListener('click', () => {
                        sidebarEl.classList.toggle('collapsed');
                    });

                    // Quand la transition de la sidebar est terminée -> recalcul carte
                    sidebarEl.addEventListener('transitionend', (e) => {
                        if (!this.map) return;
                        // On ne réagit qu'aux changements de largeur / transform
                        if (e.propertyName === 'flex-basis' || e.propertyName === 'max-width' || e.propertyName === 'transform') {
                            this.map.invalidateSize();
                        }
                    });
                }

                // Abaisser / remonter la timeline
                if (toggleTimelineBtn && timelineEl) {
                    toggleTimelineBtn.addEventListener('click', () => {
                        timelineEl.classList.toggle('collapsed');
                        toggleTimelineBtn.textContent = timelineEl.classList.contains('collapsed') ? '▲' : '▼';
                    });

                    // Quand la hauteur de la timeline a fini de changer -> recalcul carte
                    timelineEl.addEventListener('transitionend', (e) => {
                        if (!this.map) return;
                        if (e.propertyName === 'height') {
                            this.map.invalidateSize();
                        }
                    });
                }

                // Sécurité : si la fenêtre change de taille → recalculer aussi
                window.addEventListener('resize', () => {
                    if (this.map) {
                        this.map.invalidateSize();
                    }
                });

                // ============================
                // Boutons d'ouverture des annuaires
                // ============================

                // Bouton "tous les événements"
                const btnOpenEvents = document.getElementById('open-events-directory');
                if (btnOpenEvents) {
                    btnOpenEvents.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        this.openEventsDirectory();
                    });
                }

                // Bouton "tous les personnages"
                const btnOpenPersons = document.getElementById('open-persons-directory');
                if (btnOpenPersons) {
                    btnOpenPersons.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        this.openPersonsDirectory();
                    });
                }

                // Bouton "tous les pays"
                const btnOpenCountries = document.getElementById('open-countries-directory');
                if (btnOpenCountries) {
                    btnOpenCountries.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        this.openCountriesDirectory();
                    });
                }

                // --- Timeline : filtres cumulables (multi) + mode UNION/INTERSECTION + reset ---
                // ✅ Version compatible avec ton HTML (inputs + datalist + chips)

                this.ensureTimelineFilterUI();

                // éléments (IDs réels de ton HTML)
                const studioCountryInput = document.getElementById('timeline-country-input');
                const studioPersonInput  = document.getElementById('timeline-person-input');
                const studioFromInput    = document.getElementById('timeline-from-year');
                const studioToInput      = document.getElementById('timeline-to-year');

                const resetBtn   = document.getElementById('timeline-reset');       // ✅ ID réel dans ton HTML
                if (typeof window.__updateTimelineModeButtons === 'function') {
                    window.__updateTimelineModeButtons();
                }

                // état (sécurisé)
                this.timelineSelectedCountries = Array.isArray(this.timelineSelectedCountries) ? this.timelineSelectedCountries : [];
                this.timelineSelectedPersons   = Array.isArray(this.timelineSelectedPersons) ? this.timelineSelectedPersons : [];
                this.timelineFilterMode        = this.timelineFilterMode || 'union';

                // helpers
                const parseYearOrNull = (v) => {
                    const x = parseInt((v || '').toString().trim(), 10);
                    return Number.isFinite(x) ? x : null;
                };

                const getValidCountry = () => {
                    const raw = (studioCountryInput && studioCountryInput.value) ? studioCountryInput.value.trim() : '';
                    if (!raw) return '';
                    return (this.timelineCountriesSet && this.timelineCountriesSet.has(raw)) ? raw : '';
                };

                const getValidPerson = () => {
                    const raw = (studioPersonInput && studioPersonInput.value) ? studioPersonInput.value.trim() : '';
                    if (!raw) return '';
                    return (this.timelinePersonsSet && this.timelinePersonsSet.has(raw)) ? raw : '';
                };

                const apply = () => {
                    // période
                    this.timelineFromYear = studioFromInput ? parseYearOrNull(studioFromInput.value) : null;
                    this.timelineToYear   = studioToInput   ? parseYearOrNull(studioToInput.value)   : null;

                    // UI chips + rendu
                    this.renderTimelineChips();
                    this.showMultiFilteredTimeline();
                };

                // refresh quand on clique sur OU/ET
                window.addEventListener('timeline-filter-mode-changed', () => {
                    apply();
                });

                // ajout pays (multi) : on valide via Set + on push + on vide l’input
                const addCountryFromInput = () => {
                    const country = getValidCountry();
                    if (country && !this.timelineSelectedCountries.includes(country)) {
                        this.timelineSelectedCountries.push(country);
                    }
                    if (studioCountryInput) studioCountryInput.value = '';
                    apply();
                };

                // ajout personnage (multi)
                const addPersonFromInput = () => {
                    const person = getValidPerson();
                    if (person && !this.timelineSelectedPersons.includes(person)) {
                        this.timelineSelectedPersons.push(person);
                    }
                    if (studioPersonInput) studioPersonInput.value = '';
                    apply();
                };

                // événements sur inputs (datalist)
                if (studioCountryInput) {
                    studioCountryInput.addEventListener('change', addCountryFromInput);
                    studioCountryInput.addEventListener('keydown', (e) => {
                        if (e.key === 'Enter') {
