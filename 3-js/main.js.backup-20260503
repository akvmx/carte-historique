                    const na = (a.pays || '').toString();
                    const nb = (b.pays || '').toString();
                    return na.localeCompare(nb, 'fr', { sensitivity: 'base' });
                });

                // Regroupement par lettre
                const groups = {};
                sorted.forEach(c => {
                    const name = (c.pays || '(sans nom)').toString().trim();
                    const firstChar = name ? name[0].toUpperCase() : '?';
                    const letter = /[A-ZÀ-ÖØ-Ý]/.test(firstChar) ? firstChar : '#';
                    if (!groups[letter]) groups[letter] = [];
                    groups[letter].push(c);
                });

                const letters = Object.keys(groups).sort((a, b) =>
                    a.localeCompare(b, 'fr', { sensitivity: 'base' })
                );

                let html = '';

                letters.forEach(letter => {
                    html += `<section class="directory-section">
                                <div class="directory-letter">${letter}</div>
                                <ul class="directory-list">`;

                    groups[letter].forEach(country => {
                        const name = (country.pays || '(sans nom)').toString();
                        const continent = country.continent || '';

                        // évènements liés à ce pays
                        const events = this.getEventsForCountry(name) || [];
                        const years = events
                            .map(ev => parseInt((ev.date || '').split('-')[0], 10))
                            .filter(y => !isNaN(y));

                        const minY = years.length ? Math.min(...years) : null;
                        const maxY = years.length ? Math.max(...years) : null;

                        const periodLabel = (minY !== null && maxY !== null)
                            ? `${minY} – ${maxY}`
                            : (minY !== null ? `${minY}` : 'période inconnue');

                        html += `
                            <li class="directory-item">
                                <button type="button"
                                        class="directory-item-title directory-country-link"
                                        data-country="${name}">
                                    ${name}
                                </button>
                                <div class="directory-item-meta">
                                    ${continent ? `<span class="directory-chip">${continent}</span>` : ''}
                                    <span>${events.length} événement(s)</span>
                                    ${years.length ? `<span>${periodLabel}</span>` : ''}
                                </div>
                            </li>
                        `;
                    });

                    html += `   </ul>
                            </section>`;
                });

                this.openDirectory('tous les pays', html);
            }

            openNotesDirectory() {
                if (!this.directoryOverlay) return;
                
                this.directoryTitleElem.textContent = '📝 Toutes les notes';
                
                const notes = this.cache.notes || [];
                
                if (notes.length === 0) {
                    this.directoryContentElem.innerHTML = '<p class="directory-empty">Aucune note disponible</p>';
                    this.directoryOverlay.classList.add('open');
                    return;
                }
                
                const sorted = [...notes].sort((a, b) => {
                    const titleA = (a.titre || '').toLowerCase();
                    const titleB = (b.titre || '').toLowerCase();
                    return titleA.localeCompare(titleB);
                });
                
                this.directoryContentElem.innerHTML = sorted.map(note => {
                    const title = note.titre || 'Sans titre';
                    const type = note.type || 'note';
                    const source = note.source || 'wiki-export';
                    const lien = note.html || '#';
                    
                    return `
                        <div class="directory-item" data-lien="${lien}">
                            <div class="directory-item-header">
                                <strong>${title}</strong>
                                <span class="directory-item-badge">${type}</span>
                            </div>
                            <div class="directory-item-meta">Source: ${source}</div>
                        </div>
                    `;
                }).join('');
                
                // Gestion des clics sur les notes
                this.directoryContentElem.querySelectorAll('.directory-item').forEach(item => {
                    item.addEventListener('click', () => {
                        const lien = item.dataset.lien;
                        const titre = item.querySelector('strong').textContent;
                        
                        // Fermer l'annuaire
                        this.directoryOverlay.classList.remove('open');
                        
                        // Ouvrir dans une fenêtre flottante
                        this.openInFloatingWindow({ 
                            type: 'event', 
                            event: { titre }, 
                            lien 
                        });
                    });
                });
                
                // Fermer l'annuaire
                const closeBtn = document.getElementById('directory-close');
                if (closeBtn) {
                    closeBtn.onclick = () => {
                        this.directoryOverlay.classList.remove('open');
                    };
                }
                
                this.directoryOverlay.classList.add('open');
            }

            // ============================
            // Gestion des vues (desktop / mobile)
            // ============================

            setMainView(view) {
                this.mainView = (view === 'timeline') ? 'timeline' : (view === 'notes' ? 'notes' : 'map');

                document.body.classList.remove('view-map', 'view-timeline', 'view-notes');
                document.body.classList.add(
                    this.mainView === 'timeline' ? 'view-timeline' :
                    (this.mainView === 'notes' ? 'view-notes' : 'view-map')
                );

                // Met à jour l'état visuel des onglets desktop
                document.querySelectorAll('.main-tab').forEach(btn => {
                    const v = btn.dataset.mainView || 'map';
                    btn.classList.toggle('active', v === this.mainView);
                });

                // si on arrive sur notes, on rend la liste (au cas où)
                if (this.mainView === 'notes') {
                    this.renderNotesList();
                }

                // Gérer l'état "collapsed" de la timeline suivant la vue
                const timelineEl = document.getElementById('timeline');
                const toggleTimelineBtn = document.getElementById('toggle-timeline');
                if (timelineEl && toggleTimelineBtn) {
                    if (this.mainView === 'timeline') {
                        timelineEl.classList.remove('collapsed');
                        toggleTimelineBtn.textContent = '▼';
                    } else {
                        timelineEl.classList.add('collapsed');
                        toggleTimelineBtn.textContent = '▲';
                    }
                }

                // Si on repasse en mode carte, on s'assure que le mobile mode est cohérent
                if (window.innerWidth <= 768 && this.mainView === 'map' && this.mobileMode === 'timeline') {
                    this.setMobileMode('map');
                }

                // ✅ garder l’URL synchronisée (sans ajouter une entrée d’historique)
                try {
                    history.replaceState(null, '', `#view=${this.mainView}`);
                } catch (e) {}
            }

            setMobileView(view) {
                const mapContainer = document.querySelector('.map-container');
                const timelineWrapper = document.querySelector('.timeline-wrapper');
                const sidebar = document.getElementById('sidebar');
                
                // Masquer tout d'abord
                if (mapContainer) mapContainer.style.display = 'none';
                if (timelineWrapper) timelineWrapper.style.display = 'none';
                if (sidebar) sidebar.classList.add('collapsed');
                
                // Afficher la vue demandée
                switch(view) {
                    case 'map':
                        if (mapContainer) {
                            mapContainer.style.display = 'flex';
                            // Forcer Leaflet à recalculer
                            setTimeout(() => {
                                if (this.map) this.map.invalidateSize();
                            }, 100);
                        }
                        break;
                        
                    case 'timeline':
                        if (timelineWrapper) {
                            timelineWrapper.style.display = 'block';
                        }
                        // Afficher la timeline mondiale par défaut
                        const worldTab = document.querySelector('.timeline-tab[data-mode="world"]');
                        if (worldTab) {
                            worldTab.click();
                        } else {
                            this.showGlobalTimeline();
                        }
                        break;
                        
                    case 'notes':
                        // Ouvrir l'annuaire des notes
                        this.openNotesDirectory();
                        // Revenir à la carte en arrière-plan
                        if (mapContainer) mapContainer.style.display = 'flex';
                        break;
                }
                
                console.log(`📱 Vue mobile changée : ${view}`);
            }
        }
        
        // ========================================
        // API PUBLIQUE POUR COMPATIBILITÉ
        // ========================================
        
        let historicalMap;
        
        function ajouterPays(nom, continent, latitude, longitude) {
            if (historicalMap) {
                const newCountry = {
                    pays: nom,
                    continent: continent,
                    coordonnees: [latitude, longitude]
                };
                historicalMap.cache.countries.push(newCountry);
                historicalMap.updateDisplay();
                historicalMap.showNotification(`✅ Pays ajouté : ${nom}`, 'success');
            }
        }
        
        function ajouterEvenement(pays, date, titre, description, categorie = 'general') {
            if (historicalMap) {
                const newEvent = {
                    pays: pays,
                    date: date,
                    titre: titre,
                    description: description,
                    categorie: categorie,
                    lien: '#'
                };
                historicalMap.cache.events.push(newEvent);
                historicalMap.updateDisplay();
                historicalMap.showNotification(`✅ Événement ajouté : ${titre}`, 'success');
            }
        }
        
        function synchroniserMaintenant() {
            if (historicalMap) {
                historicalMap.triggerSync();
            }
        }
        
        function activerSurveillance() {
            if (historicalMap && !historicalMap.watchMode) {
                historicalMap.toggleWatch();
            }
        }
        

        // ========================================
