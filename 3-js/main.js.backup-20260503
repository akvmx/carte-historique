                    const lower = personName.toLowerCase().trim();
                    p = Object.values(this.personIndex).find(x => 
                        (x.nom || '').toLowerCase().trim() === lower
                    );
                }
                if (!p) return;

                // Évènements liés triés par date
                const events = (p.events || []).slice().sort(
                    (a, b) => new Date(a.date) - new Date(b.date)
                );

                // Pays associés
                const countriesSet = new Set();
                if (Array.isArray(p.paysPrincipaux)) {
                    p.paysPrincipaux.forEach(c => { if (c) countriesSet.add(c); });
                }
                if (countriesSet.size === 0) {
                    events.forEach(ev => {
                        this.eventCountries(ev).forEach(c => countriesSet.add(c));
                    });
                }
                const countriesList = Array.from(countriesSet);

                // Titre
                const displayName = p.titre || p.nom || personName;
                titleEl.textContent = displayName;

                // Sous-titre : fonction + dates de vie formatées
                const years = events
                    .map(ev => parseInt((ev.date || '').split('-')[0], 10))
                    .filter(y => !isNaN(y));
                const minY = years.length ? Math.min(...years) : null;
                const maxY = years.length ? Math.max(...years) : null;

                const datesLabel = (() => {
                    const birth = p.naissance ? this.formatDateHuman(p.naissance) : '';
                    const death = p.mort ? this.formatDateHuman(p.mort) : '';
                    if (birth && death) return `${birth} – ${death}`;
                    if (birth && !death) return `né·e ${birth}`;
                    if (!birth && death) return `mort·e ${death}`;
                    return '';
                })();

                const subtitleParts = [];
                if (p.fonction) subtitleParts.push(p.fonction);
                if (datesLabel)  subtitleParts.push(datesLabel);

                if (!subtitleParts.length) {
                    if (events.length) {
                        subtitleParts.push(
                            `≈ ${events.length} événement(s) de ${minY !== null ? minY : '?'} à ${maxY !== null ? maxY : '?'}`
                        );
                    } else {
                        subtitleParts.push('aucun événement enregistré.');
                    }
                }
                subtitleEl.textContent = subtitleParts.join(' • ');

                // Stats biographiques (inchangé, sauf si tu veux aussi formater les dates ici)
                let statsHtml = '<div class="detail-stats-grid">';
                if (p.naissance || p.lieuNaissance) {
                    const naissance = p.naissance ? this.formatDateHuman(p.naissance) : '';
                    statsHtml += `
                        <div>
                            <div class="detail-stat-label">naissance</div>
                            <div class="detail-stat-value">
                                ${naissance || ''}${p.lieuNaissance ? ` – ${p.lieuNaissance}` : ''}
                            </div>
                        </div>
                    `;
                }
                if (p.mort || p.lieuMort) {
                    const mort = p.mort ? this.formatDateHuman(p.mort) : '';
                    statsHtml += `
                        <div>
                            <div class="detail-stat-label">mort</div>
                            <div class="detail-stat-value">
                                ${mort || ''}${p.lieuMort ? ` – ${p.lieuMort}` : ''}
                            </div>
                        </div>
                    `;
                }
                statsHtml += `
                    <div>
                        <div class="detail-stat-label">événements liés</div>
                        <div class="detail-stat-value">${events.length}</div>
                    </div>
                    <div>
                        <div class="detail-stat-label">pays associés</div>
                        <div class="detail-stat-value">
                            ${countriesList.length ? countriesList.join(', ') : '–'}
                        </div>
                    </div>
                `;
                statsHtml += '</div>';
                statsEl.innerHTML = statsHtml;

                // 🟣 Biographie longue : on privilégie bioLongue, puis bioCourte
                if (bioSection && bioEl) {
                    const bio = p.bioLongue || p.bioCourte || '';
                    if (bio) {
                        bioSection.style.display = 'block';
                        // 🔥 Convertir Markdown → HTML avec Marked
                        const rendered = marked.parse(bio);

                        // 🔥 Injecter le HTML converti
                        bioEl.innerHTML = `
                            <div class="person-bio md-content">
                                ${rendered}
                            </div>
                        `;
                    } else {
                        bioSection.style.display = 'none';
                        bioEl.innerHTML = '';
                    }
                }

                // Chronologie condensée : uniquement les événements, dates jolies
                if (events.length === 0) {
                    timelineEl.innerHTML = `<p class="no-events">Aucun événement à afficher.</p>`;
                } else {
                    const timelineHtml = events.map(ev => {
                        const lien    = ev.lien && ev.lien !== '#' ? ev.lien : null;
                        const dateStr = ev.date ? this.formatDateHuman(ev.date) : '';
                        const titre   = ev.titre || '(sans titre)';

                        return `
                            <button class="detail-timeline-item"
                                    ${lien ? `data-lien="${lien}"` : ''}>
                                <span class="detail-timeline-date">${dateStr}</span>
                                <span class="detail-timeline-separator">—</span>
                                <span class="detail-timeline-title">${titre}</span>
                            </button>
                        `;
                    }).join('');
                    timelineEl.innerHTML = timelineHtml;
                }

                // Pays associés en pastilles
                if (personsTitleEl) {
                    personsTitleEl.textContent = 'pays associés.';
                }

                if (!countriesList.length) {
                    personsEl.innerHTML = `<p class="no-events">Aucun pays encore relié à ce personnage.</p>`;
                } else {
                    personsEl.innerHTML = `
                        <div class="detail-persons-list">
                            ${countriesList
                                .sort((a, b) => a.localeCompare(b, 'fr', { sensitivity: 'base' }))
                                .map(c => `
                                    <button class="detail-person-chip detail-country-chip"
                                            data-country="${c}">
                                        ${c}
                                    </button>
                                `).join('')}
                        </div>
                    `;
                }
                
                // --- Mini-carte centrée sur un événement du personnage ---
                const mapDiv = document.getElementById('detail-map');
                if (mapDiv) {
                    // Si la mini-carte existante n'est plus attachée au bon div, on la recrée
                    if (this.detailMap && this.detailMap._container !== mapDiv) {
                        this.detailMap.remove();
                        this.detailMap = null;
                    }

                    if (!this.detailMap) {
                        this.detailMap = L.map(mapDiv, {
                            center: [20, 0],
                            zoom: 3,
                            zoomControl: false,
                            attributionControl: false
                        });
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                            maxZoom: 10
                        }).addTo(this.detailMap);
                    }

                    // On cherche un événement avec des coordonnées [lat, lng]
                    const firstWithCoords = events.find(ev => Array.isArray(ev.coords) && ev.coords.length === 2);
                    if (firstWithCoords) {
                        const [lat, lng] = firstWithCoords.coords;
                        this.detailMap.setView([lat, lng], 4);
                    }

                    setTimeout(() => {
                        this.detailMap.invalidateSize();
                    }, 150);
                }

                overlay.classList.add('open');
            }

            async loadEventHtml(lien) {
                try {
                    const response = await fetch(lien);
                    if (!response.ok) throw new Error(`Erreur ${response.status}`);
                    
                    let html = await response.text();
                    
                    // Si c'est un fichier markdown, le parser
                    if (lien.endsWith('.md') && typeof marked !== 'undefined') {
                        html = marked.parse(html);
                    }
                    
                    // Si le HTML contient un <body>, extraire uniquement son contenu
                    const bodyMatch = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
                    if (bodyMatch) {
                        html = bodyMatch[1];
                    }
                    
                    // Si le HTML contient un <main> ou <article>, extraire son contenu
                    const mainMatch = html.match(/<main[^>]*>([\s\S]*?)<\/main>/i);
                    if (mainMatch) {
                        html = mainMatch[1];
                    }
                    
                    const articleMatch = html.match(/<article[^>]*>([\s\S]*?)<\/article>/i);
                    if (articleMatch) {
                        html = articleMatch[1];
                    }
                    
                    // Supprimer les balises <style> et <script> qui pourraient interférer
                    html = html.replace(/<style[^>]*>[\s\S]*?<\/style>/gi, '');
                    html = html.replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '');
                    html = html.replace(/<link[^>]*>/gi, '');
                    
                    // Wrapper le contenu avec notre classe
                    return `
                        <article class="event-content floating-event-article">
                            ${html}
                        </article>
                    `;
                    
                } catch (error) {
                    console.error('Erreur chargement événement:', error);
                    return `
                        <div class="error-message">
                            <p>Impossible de charger le contenu de cet événement.</p>
                            <small>${lien}</small>
                        </div>
                    `;
                }
            }

            async openEventPage(lien) {
                if (!lien || lien === '#') return;

                const overlay        = document.getElementById('detail-overlay');
                const titleEl        = document.getElementById('detail-title');
                const subtitleEl     = document.getElementById('detail-subtitle');
                const statsEl        = document.getElementById('detail-stats');
                const timelineEl     = document.getElementById('detail-timeline');
                const personsEl      = document.getElementById('detail-persons');
                const personsTitleEl = document.getElementById('detail-persons-title');
                const bioSection     = document.getElementById('detail-bio-section');
                const bioEl          = document.getElementById('detail-bio');

                if (!overlay || !titleEl || !subtitleEl || !statsEl || !timelineEl || !personsEl) return;

                // Mode "fiche événement"
                overlay.classList.add('event-mode');

                // Nettoyage des blocs qui ne servent pas en mode événement
                statsEl.innerHTML = '';
                personsEl.innerHTML = '';
                if (personsTitleEl) personsTitleEl.textContent = '';

                if (bioSection && bioEl) {
                    bioSection.style.display = 'none';
                    bioEl.innerHTML = '';
                }

                // Retrouver les métadonnées de l'évènement via son lien
                let ev = null;
                if (this.cache && Array.isArray(this.cache.events)) {
                    const target = (lien || '').replace(/^\.\//, '');
                    ev = this.cache.events.find(e => {
                        if (!e.lien) return false;
                        return (e.lien || '').replace(/^\.\//, '') === target;
                    }) || null;
                }

                // Titre + sous-titre harmonisés
                if (ev) {
                    titleEl.textContent = ev.titre || 'Fiche événement';

                    const parts = [];
                    const dateStr = ev.date ? this.formatDateHuman(ev.date) : '';
                    if (dateStr) parts.push(dateStr);

                    const countries = this.eventCountries(ev);
                    if (countries.length) {
                        parts.push(countries.join(', '));
                    }

                    if (ev.categorie) {
                        parts.push(ev.categorie);
                    }

                    subtitleEl.textContent = parts.join(' • ');
                } else {
                    titleEl.textContent = 'Fiche événement';
                    subtitleEl.textContent = '';
                }

                // Placeholder le temps de charger le HTML
                timelineEl.innerHTML = `
                    <div class="event-full-wrapper">
                        <p class="event-loading">chargement de la fiche…</p>
                    </div>
                `;
                
                overlay.classList.add('event-mode');
                overlay.classList.add('open');

                // Chargement réel du contenu de la fiche
                const html = await this.loadEventHtml(lien);

                timelineEl.innerHTML = `
                    <div class="event-full-wrapper">
                        <div class="event-full-content">
                            ${html}
                        </div>
                    </div>
                `;
            }
            
            openEventUrl(url) {
                const clean = (url || '').trim();
                if (!clean || clean === '#') return;

                // 🔥 Ouvrir dans une fenêtre flottante au lieu de changer de page
                this.openInFloatingWindow({ 
                    type: 'event', 
                    lien: clean,
                    event: { titre: 'Événement' }
                });
            }

            saveTimelineStateToSession() {
                try {
                    const state = {
                        selectedCountries: Array.isArray(this.timelineSelectedCountries) ? this.timelineSelectedCountries : [],
                        selectedPersons: Array.isArray(this.timelineSelectedPersons) ? this.timelineSelectedPersons : [],
                        fromYear: (this.timelineFromYear ?? null),
                        toYear: (this.timelineToYear ?? null),
                        mode: (this.timelineFilterMode === 'intersection') ? 'intersection' : 'union'
                    };
                    sessionStorage.setItem('timelineState', JSON.stringify(state));
                } catch (e) {
                    console.warn('saveTimelineStateToSession failed', e);
                }
            }

            restoreTimelineStateFromSession() {
                try {
                    const raw = sessionStorage.getItem('timelineState');
                    if (!raw) return false;

                    const s = JSON.parse(raw);
                    if (!s || typeof s !== 'object') return false;

                    this.timelineSelectedCountries = Array.isArray(s.selectedCountries) ? s.selectedCountries : [];
                    this.timelineSelectedPersons   = Array.isArray(s.selectedPersons) ? s.selectedPersons : [];

                    this.timelineFromYear = (Number.isFinite(parseInt(s.fromYear, 10))) ? parseInt(s.fromYear, 10) : null;
                    this.timelineToYear   = (Number.isFinite(parseInt(s.toYear, 10))) ? parseInt(s.toYear, 10) : null;

                    this.timelineFilterMode = (s.mode === 'intersection') ? 'intersection' : 'union';

                    // Remettre les champs UI (si présents)
                    const ci = document.getElementById('timeline-country-input');
                    const pi = document.getElementById('timeline-person-input');
                    const fi = document.getElementById('timeline-from-year');
                    const ti = document.getElementById('timeline-to-year');

                    if (ci) ci.value = ''; // inputs servent à AJOUTER, pas à afficher les chips
                    if (pi) pi.value = '';
                    if (fi) fi.value = (this.timelineFromYear ?? '') === null ? '' : String(this.timelineFromYear);
                    if (ti) ti.value = (this.timelineToYear ?? '') === null ? '' : String(this.timelineToYear);

                    // Si tu as le toggle OU/ET en boutons, on met à jour l'UI si tu as exposé un update
                    if (typeof window.__updateTimelineModeButtons === 'function') {
                        window.__updateTimelineModeButtons();
                    }

                    // Relancer l’affichage filtré
                    if (typeof this.renderTimelineChips === 'function') this.renderTimelineChips();
                    if (typeof this.showMultiFilteredTimeline === 'function') this.showMultiFilteredTimeline();

                    return true;
                } catch (e) {
                    console.warn('restoreTimelineStateFromSession failed', e);
                    return false;
                }
            }

            updateStats() {
                const nbPaysElement = document.getElementById('nb-pays');
                const nbEvenementsElement = document.getElementById('nb-evenements');

                if (!nbPaysElement || !nbEvenementsElement) return;

                let countriesWithEvents = 0;
                let totalEvents = 0;

                // On part des pays déjà filtrés par continent
                let filteredCountries = this.cache.countries;
                if (this.selectedContinent !== "tous") {
                    filteredCountries = this.cache.countries.filter(
                        country => country.continent === this.selectedContinent
                    );
                }

                filteredCountries.forEach(country => {
                    // On regarde les événements correspondant à ce pays
                    const eventsForCountry = this.cache.events.filter(ev => {
                        if (!this.eventBelongsToCountry(ev, country.pays)) {
                            return false;
                        }

                        if (this.eventDisplayMode === "all") {
                            return true;
                        }

                        return this.isEventVisibleForYear(ev, this.selectedYear);
                    });

                    if (eventsForCountry.length > 0) {
                        countriesWithEvents++;
                        totalEvents += eventsForCountry.length;
                    }
                });

                // Utiliser l'animation si la méthode existe
                if (typeof this.animateNumber === 'function') {
                    this.animateNumber(nbPaysElement, countriesWithEvents);
                    this.animateNumber(nbEvenementsElement, totalEvents);
                } else {
                    nbPaysElement.textContent = countriesWithEvents;
                    nbEvenementsElement.textContent = totalEvents;
                }
            }

            isEventVisibleForYear(event, year) {
                const eventStartYear = parseInt(event.date.split('-')[0]);

                // 1) PÉRIODE DÉTERMINÉE : visible entre début et fin inclus
                if (event.date_fin) {
                    const eventEndYear = parseInt(event.date_fin.split('-')[0]);
                    return eventStartYear <= year && year <= eventEndYear;
                }

                // 2) PERPÉTUEL : visible à partir de la date de début
                if (event.perpetuel) {
                    return eventStartYear <= year;
                }

                // 3) PONCTUEL : visible UNIQUEMENT l'année où il a lieu
                return eventStartYear === year;
            }

            eventCountries(event) {
                if (!event || !event.pays) return [];
                return Array.isArray(event.pays) ? event.pays : [event.pays];
            }

            eventBelongsToCountry(event, countryName) {
                const target = countryName.toLowerCase();
                return this.eventCountries(event).some(
                    p => (p || "").toLowerCase() === target
                );
            }

            getEventsForCountry(countryName) {
                return this.cache.events.filter(event => {
                    if (!this.eventBelongsToCountry(event, countryName)) {
                        return false;
                    }

                    if (this.eventDisplayMode === "all") {
                        return true;
                    }

                    return this.isEventVisibleForYear(event, this.selectedYear);
                });
            }
            
            createMarker(country, events) {
                // 1️⃣ Vérification de base : est-ce qu'on a bien un tableau de 2 éléments ?
                if (!country.coordonnees || 
                    !Array.isArray(country.coordonnees) || 
                    country.coordonnees.length !== 2) {
                    console.warn(`❌ Coordonnées invalides pour ${country.pays}:`, country.coordonnees);
                    return;
                }
                
                // 2️⃣ Conversion en nombres (même si c'était des strings)
                const lat = parseFloat(country.coordonnees[0]);
                const lng = parseFloat(country.coordonnees[1]);
                
                // 3️⃣ Vérification que la conversion a fonctionné
                if (isNaN(lat) || isNaN(lng)) {
                    console.warn(`❌ Impossible de convertir en nombres pour ${country.pays}: [${country.coordonnees[0]}, ${country.coordonnees[1]}]`);
                    return;
                }
                
                // 4️⃣ Vérification que les coordonnées sont réalistes
                if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
                    console.warn(`❌ Coordonnées hors limites pour ${country.pays}: [${lat}, ${lng}]`);
                    return;
                }

                const iconSize = Math.min(15 + events.length * 2, 30);
                const customIcon = L.divIcon({
                    html: `<div style="
                        width: ${iconSize}px;
                        height: ${iconSize}px;
                        background: var(--couleur-accent);
                        border: 3px solid white;
                        border-radius: 50%;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        color: white;
                        font-weight: bold;
                        font-size: ${Math.max(8, iconSize/3)}px;
                        box-shadow: 0 2px 8px rgba(0,0,0,0.3);
                    ">${events.length}</div>`,
                    className: 'custom-marker',
                    iconSize: [iconSize, iconSize],
                    iconAnchor: [iconSize/2, iconSize/2]
                });
                
                // Contenu affiché en survol (tooltip)
                let hoverContent = `
                    <div style="min-width: 220px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--couleur-accent); font-size: 0.95rem;">
                            ${country.pays}
                        </h3>
                        <p style="margin: 0 0 6px 0; font-size: 0.8rem;">
                            <strong>${events.length}</strong> événement(s)
                        </p>
                `;
                
                events.slice(0, 3).forEach(event => {
                    const categoryIcon = this.getCategoryIcon(event.categorie);
                    const dateStr      = this.formatDateHuman(event.date);

                    hoverContent += `
                        <div style="margin: 4px 0; padding: 6px 8px; background: rgba(15,23,42,0.05); border-radius: 6px;">
                            <div style="font-size: 0.78rem; opacity: 0.9; margin-bottom: 2px;">
                                ${categoryIcon} ${dateStr}
                            </div>
                            <div style="font-size: 0.8rem; font-weight: 600;">
                                ${event.titre}
                            </div>
                        </div>
                    `;
                });
                
                if (events.length > 3) {
                    hoverContent += `<p style="margin: 4px 0 0 0; font-size: 0.75rem; opacity: 0.8;">
                        … et ${events.length - 3} autre(s)
                    </p>`;
                }
                hoverContent += '</div>';
                
                const marker = L.marker([lat, lng], { icon: customIcon })
                    .addTo(this.markers);
                
                // Tooltip au survol au lieu du popup au clic
                marker.bindTooltip(hoverContent, {
                    direction: 'top',
                    sticky: true,
                    opacity: 0.95,
                    className: 'marker-tooltip'
                });
                
                // Clic = fiche pays dans la sidebar
                marker.on('click', () => {
                    this.openInFloatingWindow({ type: 'country', name: country.pays });
                });

                this.markers[country.pays] = marker;
            }
            
            getCategoryIcon(category) {
                const icons = {
                    'politique': '🏛️',
                    'science': '🔬',
                    'social': '👥',
                    'economie': '💰',
                    'culture': '🎨',
                    'guerre': '⚔️',
                    'default': '📅'
                };
                return icons[category] || icons.default;
            }
            
            showTimeline(countryName) {
                this.currentTimelineContext = {
                    type: 'country',
                    name: countryName
                };

                const timelineContent = document.getElementById('timeline-content');
                const timeline = document.getElementById('timeline');

                if (!timelineContent || !timeline) return;

                timeline.classList.remove('collapsed');
                const toggleBtn = document.getElementById('toggle-timeline');
                if (toggleBtn) toggleBtn.textContent = '▼';

                let events = this.cache.events
                    .filter(ev => this.eventBelongsToCountry(ev, countryName))
                    .sort((a, b) => new Date(a.date) - new Date(b.date));

                events = this.filterEventsByTimelinePeriod(events);

                if (!events.length) {
                    timelineContent.innerHTML = `
                        <h3 class="timeline-section-title">📜 Timeline – ${countryName}</h3>
                        <p>Aucun événement trouvé pour ${countryName}.</p>
                    `;
                    this.drawTimeline([]);
                    return;
                }

                // frise locale (en bas de l’écran carte)
                this.drawTimeline(events);

                // liste structurée par siècle + personnages au-dessus
                const title = `📜 Timeline – ${countryName}`;
                const personsInlineHtml = this.buildCountryPersonsInline(countryName);

                timelineContent.innerHTML = this.buildTimelineList(events, {
                    title,
                    showCountries: false,
                    showMiniMap: false,                    // 👉 on désactive la mini-map
                    extraSummaryFooterHtml: personsInlineHtml // 👉 on met la liste des personnages
                });

                this.currentTimelineEvents = events;
                this.setupTimelineListInteractions(timelineContent, events, 'country');
            }

            renderNotesList() {
                const grid = document.getElementById('notes-grid');
                const countEl = document.getElementById('notes-count');
                const searchEl = document.getElementById('notes-search');
                if (!grid) return;

                const notes = Array.isArray(this.cache.notes) ? this.cache.notes : [];
                const query = (searchEl ? searchEl.value : '').trim().toLowerCase();

                const filtered = notes.filter(n => {
                    const t = (n.titre || '').toLowerCase();
                    const s = (n.source || '').toLowerCase();
                    return !query || t.includes(query) || s.includes(query);
                });

                // tri alphabétique
                const sorted = [...filtered].sort((a, b) => {
                    const ta = (a.titre || '').toLowerCase();
                    const tb = (b.titre || '').toLowerCase();
                    return ta.localeCompare(tb, 'fr', { sensitivity: 'base' });
                });

                if (countEl) countEl.textContent = String(sorted.length);

                if (sorted.length === 0) {
                    grid.innerHTML = `<div class="note-empty">Aucune note trouvée.</div>`;
                    return;
                }

                // ✅ MODIFIÉ : utilise data-note et data-lien au lieu de <a href>
                grid.innerHTML = sorted.map(n => {
                    const title = n.titre || 'Sans titre';
                    const href = n.html || '#';
                    const kicker = (n.type || 'note').toString();
                    const source = (n.source || '').toString();
                    const rightMeta = source ? source : 'wiki-export';

                    return `
                        <div class="note-card" 
                            data-note="${title.replace(/"/g, '&quot;')}" 
                            data-lien="${href}">
                            <div class="note-card-kicker">✦ ${kicker}</div>
                            <h3 class="note-card-title">${title}</h3>
                            <div class="note-card-meta">
                                <span></span>
                                <span>${rightMeta}</span>
                            </div>
                        </div>
                    `;
                }).join('');
            }

            drawTimeline(events) {
                const track = document.getElementById("timeline-track");
                if (!track) return;

                track.innerHTML = "";
                this.timelineDots = [];
                this.currentTimelineEvents = events || [];
                this.selectedTimelineIndex = null;

                if (!events || events.length === 0) return;

                const years = (events || [])
                    .map(ev => {
                        if (!ev.date || typeof ev.date !== "string") return NaN;
                        const yearStr = ev.date.split("-")[0];
                        const year = parseInt(yearStr, 10);
                        return isNaN(year) ? NaN : year;
                    })
                    .filter(y => !isNaN(y));

                if (years.length === 0) return;

                const maxYearEvents = Math.max(...years);

                // 🕒 Année "aujourd'hui"
                const currentYear = 2024;

                // On veut que l'axe aille au moins jusqu'à aujourd'hui
                const finalMaxYear = Math.max(maxYearEvents, currentYear);

                // 🧭 Début de la timeline TOUJOURS à -500
                const start = -500;
                const end   = Math.ceil(finalMaxYear / 100) * 100;
                const visibleYears = end - start || 100;

                // 🎯 Objectif : ~1000 ans visibles à l'écran pour zoom = 1
                const trackWidth = track.clientWidth || 800;
                const yearsPerScreen = 1000;
                let pxPerYear = (trackWidth / (yearsPerScreen * this.timelineZoom));

                const MIN = 0.5;
                const MAX = 30;
                pxPerYear = Math.max(MIN, Math.min(MAX, pxPerYear));

                const totalWidth = visibleYears * pxPerYear;

                // Conteneur interne
                const inner = document.createElement("div");
                inner.className = "timeline-track-inner";
                inner.style.width = totalWidth + "px";
                track.appendChild(inner);

                // Axe
                const axis = document.createElement("div");
                axis.className = "timeline-axis";
                axis.style.width = totalWidth + "px";
                inner.appendChild(axis);

                // Repères d'années tous les 50 ans
                for (let y = start; y <= end; y += 50) {
                    const label = document.createElement("div");
                    label.className = "timeline-year";
                    label.textContent = y;
                    const x = (y - start) * pxPerYear;
                    label.style.left = x + "px";
                    inner.appendChild(label);
                }

                // Tooltip unique
                const tooltip = document.createElement("div");
                tooltip.className = "timeline-tooltip";
                inner.appendChild(tooltip);

                const dots = [];

                events.forEach((ev, index) => {
                    if (!ev.date || typeof ev.date !== "string") return;

                    const yearStr = ev.date.split("-")[0];
                    const year = parseInt(yearStr, 10);
                    if (isNaN(year)) return;

                    const xPos = (year - start) * pxPerYear;
                    const dot = document.createElement("div");
                    dot.className = "timeline-dot";
                    dot.style.left = xPos + "px";

                    const description = `${ev.date} — ${ev.titre}`;

                    dot.addEventListener("mouseenter", () => {
                        tooltip.textContent = description;
                        tooltip.style.left = xPos + "px";
                        tooltip.classList.add("visible");
                    });

                    dot.addEventListener("mouseleave", () => {
                        tooltip.classList.remove("visible");
                    });

                    dot.addEventListener("click", () => {
                        this.focusTimelineEvent(index);
                    });

                    dots.push(dot);
                    inner.appendChild(dot);
                });

                this.timelineDots = dots;

                // ✅ sélectionner automatiquement le premier événement
                if (dots.length > 0) {
                    this.focusTimelineEvent(0);
                }

                // Zoom + pan à la molette
                track.onwheel = (e) => {
                    e.preventDefault();

                    // Shift + molette = scroll horizontal (pan)
                    if (e.shiftKey) {
                        track.scrollLeft += e.deltaY; // inverse si tu préfères l’autre sens
                        return;
                    }

                    // Sinon : zoom temporel
                    if (e.deltaY > 0) {
                        // dé-zoom
                        this.timelineZoom = Math.max(this.timelineMinZoom, this.timelineZoom / 1.6);
                    } else {
                        // zoom
                        this.timelineZoom = Math.min(this.timelineMaxZoom, this.timelineZoom * 1.6);
                    }

                    this.drawTimeline(this.currentTimelineEvents);

                    if (this.selectedTimelineIndex !== null) {
                        this.focusTimelineEvent(this.selectedTimelineIndex);
                    }
                };

                // Click & drag pour faire défiler la timeline
                let isDragging = false;
                let startX = 0;
                let startScrollLeft = 0;

                track.onmousedown = (e) => {
                    isDragging = true;
                    track.classList.add('dragging');
                    startX = e.clientX;
                    startScrollLeft = track.scrollLeft;
                };

                track.onmouseleave = () => {
                    isDragging = false;
                    track.classList.remove('dragging');
                };

                track.onmouseup = () => {
                    isDragging = false;
                    track.classList.remove('dragging');
                };

                track.onmousemove = (e) => {
                    if (!isDragging) return;
                    e.preventDefault();
                    const dx = e.clientX - startX;
                    track.scrollLeft = startScrollLeft - dx;
                };
            }

